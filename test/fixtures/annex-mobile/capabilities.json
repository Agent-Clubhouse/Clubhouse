{
  "request": {
    "method": "GET",
    "path": "/api/v1/mobile/capabilities"
  },
  "response": {
    "body": {
      "agentAddress": {
        "format": "{agentId}@{machine}",
        "snapshotField": "machine",
        "version": 1,
        "wrongMachineCode": "wrong_machine"
      },
      "agentSettings": {
        "path": "/api/v1/mobile/agents/{agentId}/settings",
        "version": 1
      },
      "agentState": {
        "path": "/api/v1/mobile/agents/state",
        "version": 1
      },
      "attachments": {
        "imageTypes": [
          "image/png",
          "image/jpeg",
          "image/gif",
          "image/webp"
        ],
        "maxCount": 10,
        "maxImageBytes": 3932160,
        "version": 1
      },
      "chatControls": {
        "version": 1
      },
      "chatLinks": {
        "maxEntries": 500,
        "path": "/api/v1/mobile/agents/{agentId}/link?href={href}",
        "version": 1
      },
      "commands": [
        "chat.send",
        "chat.interrupt",
        "chat.permission",
        "chat.question",
        "chat.queue.remove",
        "agent.start",
        "agent.stop",
        "agent.spawn",
        "agent.create",
        "agent.update",
        "project.setPinned",
        "project.setInactive",
        "helper.approve",
        "helper.decline",
        "chat.setModel",
        "chat.setLevel",
        "quick.dismiss",
        "quick.clear",
        "dispatcher.setEnabled",
        "helperRouting.update",
        "agent.providerPreview",
        "agent.providerChange"
      ],
      "contextWindow": {
        "version": 1
      },
      "controlAuth": "mtls-pinned-client",
      "controlAvailable": true,
      "createOptions": {
        "path": "/api/v1/mobile/projects/{projectId}/create-options",
        "version": 1
      },
      "dispatcher": {
        "commands": [
          "dispatcher.setEnabled"
        ],
        "enabled": false,
        "event": "dispatcher:changed",
        "flagOn": true,
        "newLayout": true,
        "projectId": "__dispatcher__",
        "snapshotField": "dispatcher",
        "version": 1
      },
      "epoch": "00000000-0000-4000-8000-000000000001",
      "events": {
        "queueState": "queue_state",
        "replayRequest": "mobile:replay",
        "transport": "annex-websocket"
      },
      "finishedQuickAgents": {
        "version": 1
      },
      "fullEvents": {
        "approvalField": "reviewedDigest",
        "maximumBytes": 33554432,
        "path": "/api/v1/mobile/agents/{agentId}/chat/events/{seq}?sessionId={sessionId}",
        "version": 1
      },
      "helperRequests": {
        "commands": [
          "helper.approve",
          "helper.decline"
        ],
        "snapshotField": "helperRequests",
        "version": 1
      },
      "helperRouting": {
        "autoCandidates": [
          "claude-code",
          "codex-cli"
        ],
        "autoOffReasons": [
          "not_enabled",
          "project_off",
          "orchestration_off",
          "mcp_off",
          "dispatcher_locked"
        ],
        "cellStates": [
          "valid",
          "unverified",
          "stale"
        ],
        "commands": [
          "helperRouting.update"
        ],
        "difficulties": [
          "easy",
          "medium",
          "hard"
        ],
        "event": "helper_routing:changed",
        "fallbacks": [
          "none",
          "builtin_preset",
          "candidate_skipped",
          "model_unverified"
        ],
        "levels": [
          "minimum",
          "easy",
          "medium",
          "hard",
          "maximum"
        ],
        "modes": [
          "explicit",
          "preset",
          "auto"
        ],
        "path": "/api/v1/mobile/helper-routing",
        "presetProviders": [
          "claude-code",
          "codex-cli",
          "copilot-cli"
        ],
        "quota": true,
        "quotaSources": [
          "cli_query",
          "session_event",
          "none"
        ],
        "quotaStates": [
          "known",
          "low",
          "near_limit",
          "exhausted",
          "unknown"
        ],
        "reasons": [
          "explicit_request",
          "persona_pinned",
          "preset_on_cli",
          "only_candidate",
          "lower_pressure",
          "lower_load",
          "fair_rotation",
          "better_quota_tier",
          "unknown_fallback",
          "sticky",
          "default_order"
        ],
        "scopes": [
          "app",
          "project",
          "agent"
        ],
        "skipped": [
          "cli_disabled",
          "cli_unavailable",
          "auto_not_supported",
          "no_valid_mapping",
          "cooling_down",
          "quota_near_limit",
          "quota_exhausted"
        ],
        "snapshotField": "helperRoutingRevision",
        "unknownReasons": [
          "not_read",
          "stale",
          "not_applicable",
          "read_failed",
          "not_supported"
        ],
        "version": 1
      },
      "iconRefs": {
        "clientParam": "client=mobile",
        "connectParam": "iconRefs=1",
        "paths": {
          "agent": "/api/v1/icons/agent/{agentId}?v={version}",
          "project": "/api/v1/icons/project/{projectId}?v={version}"
        },
        "version": 1
      },
      "idempotency": {
        "maxEntries": 2048,
        "scope": "peer-and-epoch",
        "ttlMs": 3600000
      },
      "network": {
        "event": "network:changed",
        "membersPath": "/api/v1/mobile/network/members",
        "pairField": "network",
        "path": "/api/v1/mobile/network",
        "version": 1
      },
      "orchestration": {
        "version": 1
      },
      "pairing": {
        "sessionRevokePath": "/api/v1/mobile/pairing"
      },
      "permissions": {
        "freeAgentMode": true,
        "persistentApprovals": true,
        "version": 1
      },
      "projectState": {
        "version": 1
      },
      "providerControl": {
        "change": "agent.providerChange",
        "preview": "agent.providerPreview",
        "stoppedAcknowledgment": true,
        "strictStart": true,
        "version": 1
      },
      "richContent": {
        "enabled": true,
        "maximumBytes": 8388608,
        "version": 1
      },
      "routes": {
        "hosts": [
          "127.0.0.1"
        ],
        "port": 7432
      },
      "slashCommands": {
        "event": "commands_available",
        "maxCommands": 200,
        "snapshotField": "slashCommands",
        "version": 1
      },
      "snapshotTruncation": {
        "canvasPaths": {
          "app": "/api/v1/mobile/canvas",
          "project": "/api/v1/mobile/canvas/{projectId}"
        },
        "version": 1
      },
      "terminal": {
        "agentAttach": true,
        "agentShell": true,
        "maxInputLength": 65536,
        "maxShellsPerConnection": 8,
        "projectShell": true,
        "version": 1
      },
      "version": 1
    },
    "status": 200
  }
}
