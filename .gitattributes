# Vendored `codex app-server generate-ts` output (scripts/generate-codex-app-server-types.mjs).
src/main/orchestrators/adapters/codex-protocol/generated/** linguist-generated=true eol=lf

# Generated by scripts/build-workbook-arm.mjs; keep LF so the generator check matches on Windows.
docs/telemetry/workbook/azuredeploy.json eol=lf
docs/telemetry/workbook/alerts.json eol=lf

# Vendored framebriar SDK (scripts/vendor-framebriar.mjs); keep LF so the pinned sha256 manifest matches on Windows.
src/main/vendor/framebriar/** eol=lf

# Generated by `npm run fixtures:annex-mobile`; keep LF so the stale-fixture check matches on Windows.
test/fixtures/annex-mobile/** linguist-generated=true eol=lf

# Chat E2E media (scripts/chat-fixtures/make-media.mjs): byte-exact on every OS. The PDF is all ASCII, so
# without this a CRLF checkout on Windows would shift its xref offsets.
test/chat-media/*.png binary
test/chat-media/*.pdf binary
test/chat-media/*.wav binary
test/chat-media/*.webm binary
