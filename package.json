{
  "name": "clubhouse",
  "productName": "Clubhouse",
  "version": "0.41.0-beta.5",
  "description": "A place to hangout with your agent BFFs",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project main --project shared",
    "test:components": "vitest run --project renderer",
    "test:e2e": "npx playwright test",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run make && npm run test:e2e",
    "postinstall": "node scripts/fix-node-pty-win.js"
  },
  "keywords": [],
  "author": {
    "name": "Agent-Clubhouse",
    "url": "https://github.com/Agent-Clubhouse"
  },
  "license": "MIT",
