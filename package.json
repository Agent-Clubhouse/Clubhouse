{
  "name": "clubhouse",
  "productName": "Clubhouse",
  "version": "0.42.0-beta.11",
  "description": "A place to hangout with your agent BFFs",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project main --project shared",
    "test:components": "vitest run --project renderer",
    "test:e2e": "npx playwright test",
    "check:test-coverage-ratchet": "node scripts/check-test-coverage-ratchet.mjs",
    "codex:generate-types": "node scripts/generate-codex-app-server-types.mjs",
    "codex:check-types": "node scripts/generate-codex-app-server-types.mjs --check",
    "framebriar:vendor": "node scripts/vendor-framebriar.mjs --from",
    "framebriar:check": "node scripts/vendor-framebriar.mjs --check",
    "fixtures:annex-mobile": "node scripts/annex-mobile-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm test && npm run make && npm run test:e2e",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "keywords": [],
  "author": {
    "name": "Agent-Clubhouse",
    "url": "https://github.com/Agent-Clubhouse"
  },
  "license": "MIT",
  "devDependencies": {
