      "expected": "no name-store read/write/health gate; existing save/runtime disable works"
    },
    {
      "id": "Q05-use-local-Alias",
      "expected": "same queue reads current preference in turn; metadata only; no settings save/settingsChanged/applyNetworkSettings"
    },
    {
      "id": "Q06-navigation-during-flush",
      "expected": "main-frame navigation/document replacement while held atomic flush rejects precondition; no successful activation/publication; next non-name queue task proceeds"
    },
    {
      "id": "Q07-save-failure",
      "expected": "discard intent, no activation/publish, typed failure; failed cleanup is explicit unconfirmed/degraded, not claimed rollback"
    },
    {
      "id": "Q08-after-save-failure",
      "expected": "existing settingsChanged/runtime apply retained; activation failure keeps original pending stamp, explicit name-unconfirmed; no settings/runtime rollback"
    },
    {
      "id": "Q09-remote-during-intent",
      "expected": "newer remote winner survives activation of old reserved local stamp; no retimestamp"
    },
    {
