+
+describe('disposable final-output R1 controls', () => {
+  function arrange(context: TestContext, kind: 'write' | 'clock') {
+    const recorder = createPhaseRecorder(context);
+    const key = recorder.begin('body');
+    recorder.end(key, false);
+    deliveryPhases.active = recorder;
+    const originalConsole = console.error;
+    const originalWriter = process.stderr.write;
+    const originalClock = performance.now;
+    const proof = {
+      kind, line: undefined as string | undefined, postFreeze: false, postClocks: 0,
+      restore: () => {},
+    };
+    const consoleSpy = vi.spyOn(console, 'error').mockImplementation((...args) => {
+      if (typeof args[0] === 'string') proof.line = args[0];
+      Reflect.apply(originalConsole, console, args);
+    });
+    let failedFinal = false;
+    const writer = vi.spyOn(process.stderr, 'write').mockImplementation((...args) => {
+      const text = args[0];
+      if (typeof text === 'string' && text.startsWith(PHASE_PREFIX) && text.includes('"transitions"')) {
+        proof.postFreeze = true;
+        if (kind === 'write' && !failedFinal) {
+          failedFinal = true;
+          throw new Error('proof final raw write only failure');
+        }
+      }
+      return Reflect.apply(originalWriter, process.stderr, args);
+    });
+    const clock = vi.spyOn(performance, 'now').mockImplementation(() => {
+      if (kind === 'clock' && proof.postFreeze) {
+        proof.postClocks++;
+        throw new Error('proof post-freeze clock must not be sampled');
+      }
+      return Reflect.apply(originalClock, performance, []);
+    });
+    proof.restore = () => { clock.mockRestore(); writer.mockRestore(); consoleSpy.mockRestore(); };
+    finalOutputProof = proof;
+  }
+  it('phase r1 final raw write only failure reaches remaining channel', (context) => {
+    arrange(context, 'write');
+  });
+  it('phase r1 no post-freeze clock reads or misleading timing', (context) => {
+    arrange(context, 'clock');
+  });
+});
