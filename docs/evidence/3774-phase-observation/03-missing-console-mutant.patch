+
+describe('disposable phase observer proof', () => {
+  it('phase proof setup failure', () => { expect.fail('proof setup body must not run'); });
+
+  it('phase proof deadline abort', async (context) => {
+    const recorder = deliveryPhases.active!;
+    const body = recorder.begin('body');
+    const pending = recorder.begin('proof.await');
+    try {
+      await new Promise<void>((resolve) => {
+        context.signal.addEventListener('abort', () => resolve(), { once: true });
+      });
+    } finally { recorder.end(pending, false); recorder.end(body, false); }
+  });
+
+  it('phase proof native forwarding metadata and writer failure', async () => {
+    const actual = await vi.importActual<typeof import('child_process')>('child_process');
+    const proxy = (await import('child_process')).execFile;
+    const keys = Reflect.ownKeys(actual.execFile);
+    expect(keys.length === Reflect.ownKeys(proxy).length && keys.every((key) => {
+      const left = Object.getOwnPropertyDescriptor(actual.execFile, key)!;
+      const right = Object.getOwnPropertyDescriptor(proxy, key)!;
+      return left.value === right.value && left.get === right.get && left.set === right.set
+        && left.enumerable === right.enumerable && left.configurable === right.configurable
+        && left.writable === right.writable;
+    })).toBe(true);
+    const thisArg = { sentinel: 'proof-private-native-this' };
+    const argv = ['--version'];
+    const options = { cwd: agent.worktreePath!, timeout: 10_000, maxBuffer: 8 * 1024 * 1024, windowsHide: true };
+    phaseProof.calls.length = 0;
+    let callbackCount = 0;
+    let outputOk = false;
+    const writer = vi.spyOn(process.stderr, 'write').mockImplementationOnce(() => {
+      throw new Error('proof observer raw writer failure');
+    });
+    try {
+      await new Promise<void>((resolve) => {
+        const callback = (error: Error | null, stdout: string | Buffer) => {
+          callbackCount++;
+          outputOk = !error && String(stdout).startsWith('git version ');
+          resolve();
+        };
+        const returned: ChildProcess = Reflect.apply(proxy, thisArg, ['git', argv, options, callback]);
+        expect(phaseProof.calls.length).toBe(1);
+        const call = phaseProof.calls[0];
+        expect(call.thisArg === thisArg && call.args[0] === 'git' && call.args[1] === argv
+          && call.args[2] === options && call.args[3] === callback && call.child === returned).toBe(true);
+      });
+    } finally { writer.mockRestore(); }
+    expect(callbackCount).toBe(1);
+    expect(outputOk).toBe(true);
+  });
+
+  it('phase proof native primary and real stop survive observer failure', async () => {
+    const proxy = (await import('child_process')).execFile;
+    const recorder = deliveryPhases.active!;
+    const body = recorder.begin('body');
+    const stop = setGrantedSkills(() => []);
+    phaseProof.calls.length = 0;
+    let primary: unknown;
+    let stopped = 0;
+    const writer = vi.spyOn(process.stderr, 'write').mockImplementationOnce(() => {
+      throw new Error('proof observer writer failure before native throw');
+    });
+    try {
+      try { Reflect.apply(proxy, { sentinel: 'proof-native-error-this' }, ['git', 42]); }
+      catch (error) { primary = error; }
+    } finally {
+      const cleanup = recorder.begin('grant.cleanup');
+      try { stop(); stopped++; }
+      finally { recorder.end(cleanup, false); recorder.end(body, true); writer.mockRestore(); }
+    }
+    expect(phaseProof.calls.length).toBe(1);
+    expect(primary instanceof TypeError && primary === phaseProof.calls[0].error).toBe(true);
+    expect(stopped).toBe(1);
+  });
+
+  it('phase proof retired recorder isolation owned detach and bounds', async (context) => {
+    const actual = await vi.importActual<typeof import('child_process')>('child_process');
+    const originalConsole = console.error;
+    const lines: string[] = [];
+    const consoleSpy = vi.spyOn(console, 'error').mockImplementation((...args) => {
+      if (typeof args[0] === 'string') lines.push(args[0]);
+      Reflect.apply(originalConsole, console, args);
+    });
+    const signalDetach = vi.spyOn(context.signal, 'removeEventListener');
+    deliveryPhases.active!.finish();
+    deliveryPhases.active = undefined;
+    const retired = createPhaseRecorder(context);
+    const child = new actual.ChildProcess();
+    const shared = vi.fn();
+    child.on('close', shared);
+    const retiredKey = retired.begin('git.async');
+    retired.watch(child, retiredKey);
+    const retiredClose = child.listeners('close').find((listener) => listener !== shared)!;
+    const fresh = createPhaseRecorder(context);
+    const freshKey = fresh.begin('git.async');
+    fresh.watch(child, freshKey);
+    deliveryPhases.active = fresh;
+    try {
+      retired.finish();
+      expect(retired.owner === undefined && deliveryPhases.active === fresh).toBe(true);
+      expect(child.listenerCount('close')).toBe(2);
+      expect(child.listeners('close').includes(shared)).toBe(true);
+      const beforeLate = lines.length;
+      Reflect.apply(retiredClose, child, []);
+      retired.end(retiredKey, false);
+      retired.finish();
+      expect(lines.length).toBe(beforeLate);
+      child.emit('close', 0, null);
+      expect(shared).toHaveBeenCalledTimes(1);
+      expect(child.listenerCount('close')).toBe(1);
+      deliveryPhases.active = undefined;
+      fresh.finish();
+      expect(lines.at(-1)!.includes('"active":[]')).toBe(true);
+      const bounded = createPhaseRecorder(context);
+      for (let i = 0; i < 40; i++) { const key = bounded.begin('body'); bounded.end(key, false); }
+      bounded.finish();
+      expect(lines.at(-1)!.includes('"droppedTransitions":48')).toBe(true);
+      expect(signalDetach.mock.calls.length).toBe(4);
+    } finally {
+      deliveryPhases.active = undefined;
+      fresh.finish();
+      consoleSpy.mockRestore();
+      signalDetach.mockRestore();
+    }
+  });
+
+  it('phase proof serialization failure reports unavailable without throwing', () => {
+    const recorder = deliveryPhases.active!;
+    deliveryPhases.active = undefined;
+    const serialization = vi.spyOn(JSON, 'stringify').mockImplementationOnce(() => {
+      throw new Error('proof observer serialization failure');
+    });
+    try { recorder.finish(); expect(recorder.owner).toBeUndefined(); }
+    finally { serialization.mockRestore(); }
+  });
+
+  it('phase proof original captured cleanup was not skipped', () => {
+    expect(phaseProof.stops).toBe(1);
+    expect(phaseProof.cleanupFault).toBe(false);
+  });
+});
