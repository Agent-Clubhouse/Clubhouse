+
+describe('runTurn producer-idle readiness discriminator', () => {
+  it('rejects a missing requested start before edit despite an unrelated complete turn', async () => {
+    await runTurn('unrelated', () => {});
+    const lock = path.resolve(repo, `${git('rev-parse', '--git-path', checkpointRef('agent-1', 'sess', 'missing-start', 'start'))}.lock`);
+    fs.mkdirSync(path.dirname(lock), { recursive: true });
+    fs.writeFileSync(lock, '');
+    const edit = vi.fn(() => fs.writeFileSync(path.join(repo, 'a.txt'), 'two\n'));
+    const continuation = vi.fn();
+
+    await expect(runTurn('missing-start', edit).then(continuation)).rejects.toThrow(/expected false to be true/);
+    expect(edit).not.toHaveBeenCalled();
+    expect(continuation).not.toHaveBeenCalled();
+    expect(fs.readFileSync(path.join(repo, 'a.txt'), 'utf-8')).toBe('one\n');
+    const turns = await listTurns('agent-1');
+    expect(turns.some((turn) => turn.turnId === 'missing-start')).toBe(false);
+    expect(turns.find((turn) => turn.turnId === 'unrelated')?.end).toBeTruthy();
+  });
+
+  it('rejects a missing requested end before continuation despite an unrelated complete turn', async () => {
+    await runTurn('unrelated', () => {});
+    const lock = path.resolve(repo, `${git('rev-parse', '--git-path', checkpointRef('agent-1', 'sess', 'missing-end', 'end'))}.lock`);
+    fs.mkdirSync(path.dirname(lock), { recursive: true });
+    fs.writeFileSync(lock, '');
+    const edit = vi.fn(() => fs.writeFileSync(path.join(repo, 'a.txt'), 'two\n'));
+    const continuation = vi.fn();
+
+    await expect(runTurn('missing-end', edit).then(continuation)).rejects.toThrow(/expected false to be true/);
+    expect(edit).toHaveBeenCalledOnce();
+    expect(continuation).not.toHaveBeenCalled();
+    expect(fs.readFileSync(path.join(repo, 'a.txt'), 'utf-8')).toBe('two\n');
+    const turns = await listTurns('agent-1');
+    expect(turns.find((turn) => turn.turnId === 'missing-end')?.start).toBeTruthy();
+    expect(turns.find((turn) => turn.turnId === 'missing-end')?.end).toBeUndefined();
+    expect(turns.find((turn) => turn.turnId === 'unrelated')?.end).toBeTruthy();
+  });
+});
