-tomb() { print -r -- "$1" | awk '/G$/ {sub("G","");print int($1*1024); next} /M$/ {sub("M","");print int($1)}'; }
+# Binary units as reported by top. Guard pressure rounds UP to whole MiB:
+# 0B ->0, 512K ->1, 1G ->1024, 1T ->1048576. Never floor an over-limit
+# fractional value (e.g. 12GiB+1B) back onto the allowed 12288MiB boundary.
+tomb() {
+  print -r -- "$1" | awk '
+    NR==1 && /^[0-9]+([.][0-9]+)?[BKMGT]$/ {
+      unit=substr($0,length($0)); amount=substr($0,1,length($0)-1)
+      scale=(unit=="B" ? 1/1048576 : unit=="K" ? 1/1024 : unit=="M" ? 1 : unit=="G" ? 1024 : 1048576)
+      mib=amount*scale
+      if (mib < 0 || mib > 9007199254740991) exit 1
+      whole=int(mib); if (mib > whole) whole++
+      valid=1; next
+    }
+    {invalid=1}
+    END {if (!valid || invalid) exit 1; printf "%.0f\n",whole}'
+}
 unsigned() { [[ "$1" == <-> ]]; }
 decimal() { [[ "$1" =~ '^[0-9]+([.][0-9]+)?$' ]]; }
 
