+      for (const row of page.entries) yield row;
+      if (!page.nextAfter) return;
+      after = page.nextAfter;
+    }
+  }
+  private async pending(seq: number): Promise<PendingNoticePost | undefined> {
+    const key = noticeSequenceKey(seq);
